    "@vercel/blob": "^2.8.2",
    "@vitejs/plugin-react": "^5.0.4",
    "basic-ftp": "^6.2.3",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dompurify": "^3.4.17",
    "dotenv": "^17.2.3",
    "email-addresses": "^5.0.0",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "html-to-text": "^10.0.1",
    "lucide-react": "^0.546.0",
    "mammoth": "1.13.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.63.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hot-toast": "^2.6.0",
    "sanitize-html": "^2.18.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/express": "^4.17.21",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
