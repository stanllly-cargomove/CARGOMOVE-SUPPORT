{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "tsx watch --include .env.local server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "seed:supabase": "tsx scripts/seed-supabase.ts",
    "setup:asset-acceptance": "tsx scripts/create-asset-acceptance-codes.ts",
    "set:admin-password": "tsx scripts/set-admin-password.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:auto-mail": "tsx --test tests/auto-mail.test.ts tests/auto-mail-knowledge.test.ts tests/auto-mail-ai.test.ts tests/auto-mail-learning.test.ts",
    "test:auto-mail:ui": "tsx tests/auto-mail-ui.ts",
    "test:auto-mail:navigation:ui": "tsx tests/auto-mail-navigation-ui.ts",
    "test:profile": "tsx --test tests/profile.test.ts",
    "test:profile:ui": "tsx tests/account-settings-ui.ts",
    "test:versions": "node --experimental-strip-types --test --test-isolation=none tests/system-version.test.ts tests/push-version.test.ts",
    "test:portal": "tsx --test tests/registration-config.test.ts",
    "test:portal:ui": "npm run build && tsx tests/portal-ui.ts",
    "test:pwa": "npm run build && tsx tests/pwa-ui.ts",
    "test:companies:ui": "npm run build && tsx tests/company-mobile-ui.ts",
    "generate:pwa-icons": "tsx scripts/generate-pwa-icons.ts",
    "test:scheduler": "tsx --test tests/scheduler.test.ts tests/scheduler-db.test.ts",
    "test:scheduler:ui": "tsx tests/scheduler-ui.ts",
    "test:northport": "tsx --test tests/northport.test.ts tests/northport-db.test.ts tests/northport-scan.test.ts tests/northport-reprocess.test.ts tests/northport-gp-verification.test.ts tests/northport-history.test.ts tests/northport-retry.test.ts tests/dev-tools-router.test.ts tests/dev-tools-runtime.test.ts",
    "test:northport:ui": "tsx tests/northport-ui.ts",
    "test:northport:search:ui": "tsx tests/northport-search-ui.ts",
    "test:northport:navigation:ui": "tsx tests/northport-navigation-ui.ts",
    "test:northport:review:ui": "tsx tests/northport-review-ui.ts",
    "northport:check": "tsx scripts/check-northport-ftp.ts",
    "api": "tsx server.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@sparticuz/chromium": "153.0.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/blob": "^2.8.2",
    "@vitejs/plugin-react": "^5.0.4",
    "basic-ftp": "^6.2.3",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "playwright-core": "1.63.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hot-toast": "^2.6.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
