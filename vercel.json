{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/auto-mail-preview/:path*", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ],
  "functions": {
    "api/mail.ts": {
      "maxDuration": 120
    },
    "api/dev-tools.ts": {
      "maxDuration": 120,
      "regions": [
        "sin1"
      ],
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/scheduler/auto-register-cm.ts": {
      "maxDuration": 120,
      "regions": [
        "sin1"
      ],
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/dev-tools/registration-uploads",
      "destination": "/api/dev-tools?route=registration-uploads"
    },
    {
      "source": "/api/auth/profile",
      "destination": "/api/dev-tools?route=profile"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth/session?route=logout"
    },
    {
      "source": "/api/dev-tools/system-versions",
      "destination": "/api/dev-tools?route=system-versions"
    },
    {
      "source": "/api/dev-tools/schedulers",
      "destination": "/api/dev-tools?route=schedulers"
    },
    {
      "source": "/api/dev-tools/run-scheduler",
      "destination": "/api/dev-tools?route=run-scheduler"
    },
    {
      "source": "/api/dev-tools/northport-recovery",
      "destination": "/api/dev-tools?route=northport-recovery"
    },
    {
      "source": "/api/email/:path*",
      "destination": "/api/mail?route=email/:path*"
    },
    {
      "source": "/api/auto-mail/:path*",
      "destination": "/api/mail?route=auto-mail/:path*"
    },
    {
      "source": "/api/gmail/:path*",
      "destination": "/api/mail?route=gmail/:path*"
    },
    {
      "source": "/api/company-registration",
      "destination": "/api/registration?route=submit"
    },
    {
      "source": "/api/company-lookup",
      "destination": "/api/registration?route=lookup"
    },
    {
      "source": "/api/registration-status",
      "destination": "/api/registration?route=status"
    },
    {
      "source": "/api/registration-config",
      "destination": "/api/registration?route=config"
    },
    {
      "source": "/((?!api(?:/|$)|assets(?:/|$)|icons(?:/|$)|sw\\.js$|manifest\\.webmanifest$|offline\\.html$).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/previews/home.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/previews/register.html",
      "destination": "/register",
      "permanent": true
    },
    {
      "source": "/previews/track-status.html",
      "destination": "/track-status",
      "permanent": true
    },
    {
      "source": "/previews/guideline.html",
      "destination": "/guideline",
      "permanent": true
    },
    {
      "source": "/previews/login.html",
      "destination": "/login",
      "permanent": true
    }
  ]
}
