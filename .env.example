# Safe to expose in the browser. Never put a service-role key in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key
SUPABASE_ANON_KEY=your_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
SESSION_SECRET=replace_with_a_long_random_server_secret
# Vercel sets BLOB_STORE_ID when a public Blob store is connected; the SDK uses Vercel OIDC.
BLOB_STORE_ID=
# Alternative for local development: a server-only Blob read-write token.
BLOB_READ_WRITE_TOKEN=

# Temporary local-only value for `npm run set:admin-password`. Do not commit it.
# ADMIN_PASSWORD=replace_with_a_new_admin_password

# Used only by the server-side seed command. Keep this in .env.local, never commit it.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server-only production CargoMove scheduler login. Never use VITE_ prefixes.
# External system only; execution remains restricted to the fixed CargoMove host/task.
CARGOMOVE_URL=https://www.cargomove.my
# Portal origin for scheduler CSRF checks; falls back to existing APP_URL if omitted.
SCHEDULER_PORTAL_URL=https://your-admin-portal-domain
CARGOMOVE_USERNAME=
CARGOMOVE_PASSWORD=

# Northport FTP: all variables are SERVER ONLY. Never prefix with VITE_.
NORTHPORT_FTP_HOST=ftp.cargomove.my
NORTHPORT_FTP_PORT=21
# timestamp-scan checks exact filenames in batches; full/date-pattern are legacy alternatives.
NORTHPORT_FTP_LISTING_MODE=timestamp-scan
NORTHPORT_FTP_USERNAME=northports
NORTHPORT_FTP_PASSWORD=
# Observed FileZilla setting only. Prefer true (explicit FTPS) after a read-only TLS check.
NORTHPORT_FTP_SECURE=false
NORTHPORT_FTP_ALLOW_PLAINTEXT=false
NORTHPORT_FTP_BASE_DIR=/ftp/CY/PROD/CONTAINERS
NORTHPORT_FTP_SUCCESS_DIR=/ftp/CY/PROD/CONTAINERS/SUCCESS
NORTHPORT_RECOVERY_UPLOAD_ENABLED=false
NORTHPORT_READONLY_VERIFIED=false
NORTHPORT_SINGLE_RECORD_VERIFIED=false
NORTHPORT_FILENAME_VERIFIED=false
NORTHPORT_SERIALIZATION_VERIFIED=false
NORTHPORT_NON_NORTHPORT_VERIFIED=false
NORTHPORT_DUPLICATES_VERIFIED=false
NORTHPORT_RENAME_NO_REPLACE_VERIFIED=false
NORTHPORT_TIMEZONE_VERIFIED=false

# Gmail API OAuth web application. Keep all values server-side.
# Register APP_URL/api/gmail/callback as an authorized redirect URI.
GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_OAUTH_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY="YOUR_BASE64_32_BYTE_KEY"
